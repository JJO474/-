{
  "rules": {
    "rooms": {
      "baeiple-story-main": {
        ".read": true,
        ".write": true,
        "state": {
          ".validate": "newData.hasChildren(['data', 'updatedAt', 'updatedBy'])"
        },
        "presence": {
          "$clientId": {
            ".validate": "!newData.exists() || newData.hasChildren(['online', 'connectedAt'])"
          }
        }
      }
    }
  }
}
